# ─── Bal Vakti 🐝 ortam değişkenleri ───────────────────────────
# Bu dosyayı .env olarak kopyala ve değerleri doldur.

# Telegram BotFather'dan aldığın token (https://t.me/BotFather → /newbot)
BOT_TOKEN=

# Botun kullanıcı adı (t.me/ adresindeki kısım, @ olmadan) — davet linkleri için
BOT_USERNAME=

# Vercel'e deploy ettikten sonraki adresin (https://proje-adin.vercel.app)
# Yerel testte: boş bırak ya da http://localhost:8787 yaz
APP_URL=

# Webhook güvenlik anahtarı (kendin uydur, uzun bir metin)
WEBHOOK_SECRET=

# Demo modu: initData olmadan da /api testleri çalışsın (1 = açık)
# Prodüksiyonda 0 yap!
ALLOW_DEMO=1

# ─── Veritabanı (opsiyonel) ────────────────────────────────────
# Ücretsiz Upstash Redis: https://console.upstash.com → Create Database
# (Redis Rest API) → doldur. Boş bırakırsan oyun bellek modunda çalışır
# ama veriler Vercel'de yeniden dağıtımda sıfırlanır!
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
